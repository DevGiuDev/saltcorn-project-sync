# Optional variables for future Saltcorn tenant integration.
# Do not commit real values.
SALTCORN_BASE_URL=http://localhost:3000
SALTCORN_API_TOKEN=
SALTCORN_TENANT=
SALTCORN_PROJECT_SYNC_ENV=dev
SALTCORN_PROJECT_SYNC_BACKUP_POLICY=optional

# Command adapter: lets the CLI integrate with any Saltcorn export/apply wrapper.
# EXPORT_CMD must print Saltcorn pack/snapshot-like JSON to stdout.
# APPLY_CMD receives desired normalized project JSON on stdin and should print JSON result.
# BACKUP_CMD should create a tenant backup/snapshot and print JSON metadata.
# Use `command` outside Saltcorn, `rest` for HTTP endpoints, or `native` inside a configured Saltcorn runtime.
SALTCORN_PROJECT_SYNC_ADAPTER=command
SALTCORN_PROJECT_SYNC_EXPORT_CMD=
SALTCORN_PROJECT_SYNC_APPLY_CMD=
SALTCORN_PROJECT_SYNC_BACKUP_CMD=
SALTCORN_PROJECT_SYNC_RESTORE_CMD=

# REST adapter endpoints. If explicit URLs are omitted, BASE_URL + /project-sync/api/<action> is used.
# Remote API access requires SALTCORN_PROJECT_SYNC_API_TOKEN; use HTTPS outside localhost.
SALTCORN_PROJECT_SYNC_BASE_URL=
SALTCORN_PROJECT_SYNC_API_TOKEN=
SALTCORN_PROJECT_SYNC_INFO_URL=
SALTCORN_PROJECT_SYNC_EXPORT_URL=
SALTCORN_PROJECT_SYNC_APPLY_URL=
SALTCORN_PROJECT_SYNC_BACKUP_URL=
SALTCORN_PROJECT_SYNC_RESTORE_URL=

# Non-secret environment profiles may refer to secret/hook variables by name.
# Example profile: "token_env": "PROJECT_SYNC_TEST_TOKEN".
PROJECT_SYNC_TEST_TOKEN=
PROJECT_SYNC_TEST_BACKUP_CMD=
PROJECT_SYNC_TEST_RESTORE_CMD=

# Managed SSH tunnel (prefer setting these non-secret values in environments/<env>.json).
SALTCORN_PROJECT_SYNC_TRANSPORT=direct
SALTCORN_PROJECT_SYNC_SSH_HOST=
SALTCORN_PROJECT_SYNC_SSH_USER=
SALTCORN_PROJECT_SYNC_SSH_PORT=22
SALTCORN_PROJECT_SYNC_SSH_LOCAL_PORT=3000
SALTCORN_PROJECT_SYNC_SSH_REMOTE_HOST=127.0.0.1
SALTCORN_PROJECT_SYNC_SSH_REMOTE_PORT=3000
SALTCORN_PROJECT_SYNC_SSH_IDENTITY_FILE=
